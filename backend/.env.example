NODE_ENV=development
PORT=5000
MONGO_DB_URI=mongodb://localhost:27017/voyagent
JWT_SECRET=replace-with-a-long-random-secret
# Must match the ai-service INTERNAL_API_KEY (at least 16 characters)
INTERNAL_API_KEY=replace-with-another-long-random-secret
AI_SERVICE_URL=http://localhost:8000
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
# Comma-separated admin emails: open /admin, left out of usage stats, cannot sign up publicly
ADMIN_EMAILS=
# Used only by `npm run seed:admin` to create the admin account. Never commit real values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
