# Used by `docker compose up`. Copy to .env and fill in the keys. Never commit .env.

# Backend
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=
# For `docker compose exec backend npm run seed:admin`
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Shared secret between backend and ai-service
INTERNAL_API_KEY=change-me-to-another-long-random-string

# AI service: Groq is the primary LLM, Cloudflare Workers AI the fallback
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AI service: live hotel and flight search (optional, estimates are used without it)
SEARCHAPI_KEY=
# AI service: SerpAPI backup search and Activity place details (optional, stays in the free plan)
SERPAPI_KEY=
# AI service: web search that grounds estimated flight fares (optional)
TAVILY_API_KEY=
