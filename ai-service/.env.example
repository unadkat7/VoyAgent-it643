ENVIRONMENT=development
# Must match the backend's INTERNAL_API_KEY (at least 16 characters)
INTERNAL_API_KEY=change-me-to-a-long-random-string

# At least one LLM Provider is required. Groq is tried first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: live hotel and flight search. Without it, Estimated Cost options are used.
SEARCHAPI_KEY=

# Map Locations come from free OpenStreetMap Nominatim. Set to false to skip them.
GEOCODER_ENABLED=true
