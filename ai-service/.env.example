ENVIRONMENT=development
# Must match the backend's INTERNAL_API_KEY (at least 16 characters)
INTERNAL_API_KEY=change-me-to-a-long-random-string

# At least one LLM Provider is required. Groq is tried first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: live hotel and flight search. Without it, Estimated Cost options are used.
SEARCHAPI_KEY=
# Optional: SerpAPI. Backup for live hotels/flights and fare web search, plus real ratings,
# photos and map links for a few Activities per Trip. It never spends past the monthly plan.
SERPAPI_KEY=
# Optional: Tavily web search, so estimated flight fares follow real prices for the dates.
TAVILY_API_KEY=

# Trip Map Coordinates come from free OpenStreetMap Nominatim. Set to false to skip them.
GEOCODER_ENABLED=true
